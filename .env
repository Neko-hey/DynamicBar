# app
APP_NAME=DynamicBar
APP_BUNDLE_ID=pro.nekooo.DynamicBar
APP_VERSION=1.0.0
EXECUTABLE_NAME=DynamicBar

# src
SRC_FILE=src/main.mm
ICON_PNG=src/icon.png
ICON_ICNS_NAME=AppIcon

# build
BUILD_DIR=build
DIST_DIR=app
DMG_NAME=DynamicBar.dmg

# compile setting
CXX=clang++
CXXFLAGS="-O2 -std=c++17"
FRAMEWORKS="-framework Cocoa -framework Foundation"